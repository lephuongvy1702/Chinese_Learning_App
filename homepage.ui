QTableView {
    background-color: #f9f9f9;  /* Màu nền sáng */
    border: 1px solid #ccc;     /* Viền bảng */
    border-radius: 8px;         /* Bo góc bảng */
    gridline-color: #ddd;       /* Màu lưới của bảng */
}

QHeaderView::section {
    background-color: #3498DB;  /* Màu nền của header */
    color: white;               /* Màu chữ header */
    padding: 4px;               /* Padding cho header */
    border: 1px solid #ccc;     /* Viền của header */
    border-radius: 6px;
}

QTableView QTableCornerButton::section {
    background-color: #f9f9f9;  /* Màu nền góc */
}

QTableView::item {
    padding: 8px;               /* Khoảng cách nội dung trong các ô */
    border-bottom: 1px solid #eee; /* Viền dưới mỗi ô */
}

QTableView::item:selected {
    background-color: #3498DB;  /* Màu nền ô khi được chọn */
    color: white;               /* Màu chữ khi chọn */
}
