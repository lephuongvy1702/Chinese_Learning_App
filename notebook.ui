   <property name="styleSheet">
    <string notr="true">QLineEdit {
    padding: 5px;
    font-size: 20px;
    border: 1px solid #5DADE2;
    border-radius: 6px;
}
QPushButton {
    background-color: #3498DB;
    color: white;
    padding: 5px 15px;
    border-radius: 6px;
}
QPushButton:hover {
    background-color: #2980B9;
}

QTableView {
    background-color: #f9f9f9;  /* Màu nền sáng */
    border: 1px solid #ccc;     /* Viền bảng */
    border-radius: 8px;         /* Bo góc bảng */
    gridline-color: #ddd;       /* Màu lưới của bảng */
}

QHeaderView::section {
    background-color: #3498DB;  /* Màu nền của header */
    color: white;               /* Màu chữ header */
    padding: 4px;               /* Padding cho header */
    border: 1px solid #ccc;     /* Viền của header */
    border-radius: 6px;
}

QTableView QTableCornerButton::section {
    background-color: #f9f9f9;  /* Màu nền góc */
}

QTableView::item {
    padding: 8px;               /* Khoảng cách nội dung trong các ô */
    border-bottom: 1px solid #eee; /* Viền dưới mỗi ô */
}

QTableView::item:selected {
    background-color: #3498DB;  /* Màu nền ô khi được chọn */
    color: white;               /* Màu chữ khi chọn */
}

QComboBox {
    background-color: #3498DB;
    color: white;                 /* Màu chữ xanh đậm */
    border: 1px solid #3399cc;
    border-radius:6px;
    padding: 4px 8px;
    font-weight: bold;
}

QComboBox QAbstractItemView {
    background-color: #3498DB;
    color: white;     
    selection-background-color: #99ccff;
    selection-color: #003344;
	border: 1px solid #3399cc;
    border-radius:6px;
}
</string>
